rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function admin() { return signedIn() && profile().role == 'admin'; }
    match /usuarios/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'fiscal';
      allow update: if admin();
    }
    match /ars/{id} {
      allow create: if signedIn() && request.resource.data.criadoPor == request.auth.uid && request.resource.data.status == 'aguardando';
      allow read: if signedIn() && (admin() || resource.data.criadoPor == request.auth.uid);
      allow update: if (
        signedIn() &&
        resource.data.criadoPor == request.auth.uid &&
        resource.data.status == 'aguardando' &&
        request.resource.data.status == 'aguardando' &&
        request.resource.data.criadoPor == resource.data.criadoPor
      ) || (
        admin() &&
        resource.data.status == 'aguardando' &&
        request.resource.data.status == 'recebido' &&
        request.resource.data.criadoPor == resource.data.criadoPor &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'recebidoEm', 'recebidoPor', 'recebidoPorNome'
        ])
      );
      allow delete: if signedIn() &&
        resource.data.status == 'aguardando' &&
        resource.data.criadoPor == request.auth.uid;
    }
  }
}
